---
import Base from '../../layouts/Base.astro';

// ✏️ ADD NEW SHORT STORIES HERE — two kinds of entry:
//
//  1. READ ON THE SITE — copy one of the markdown files in
//     /src/pages/writing/short-stories/, write the story, then add an entry
//     with `href` pointing at its URL (the filename is the slug).
//
//  2. PDF — drop the file in /public/stories/ and add an entry with `pdf`.
//     Clicking opens it in the site-wide pdf-modal (same look as the resume
//     modal). If JS is disabled the href falls back to the raw PDF.
//
// Newest first: entries are sorted by `date` automatically, so a new story
// can be added anywhere in the list below. (Undated entries sort to the end.)
type Story = {
  title: string;
  href?: string;      // on-site story page
  pdf?: string;       // PDF in /public/stories/
  date?: string;
  readTime?: string;
};

const stories: Story[] = [
  { title: 'Stay', href: '/writing/short-stories/stay', date: 'July 2026', readTime: '3 min read' },
  { title: 'Kunta & The Machine', href: '/writing/short-stories/kunta-and-the-machine', date: 'June 2026', readTime: '3 min read' },
  { title: 'Moon Moles', href: '/writing/short-stories/moon-moles', date: 'May 2026', readTime: '4 min read' },
  { title: 'Infinite Azure', pdf: '/stories/InfiniteAzure.pdf', date: 'March 2026' },
].sort((a, b) => (Date.parse(b.date ?? '') || 0) - (Date.parse(a.date ?? '') || 0));
---

<Base title="Short Stories" description="Short stories by Noku Chimbetete.">
  <article class="writing-page">
    <div class="back-row">
      <a href="/#writing" class="back-link">&larr; All writing</a>
    </div>
    <h1 class="page-heading">Short Stories</h1>

    {stories.length > 0 ? (
      <ol class="story-list">
        {stories.map((story) => {
          const isPdf = Boolean(story.pdf);
          const meta = [isPdf ? 'PDF' : null, story.date, story.readTime]
            .filter(Boolean)
            .join(' · ');
          return (
            <li>
              <a
                href={isPdf ? story.pdf : story.href}
                class="story-link"
                data-pdf-src={isPdf ? story.pdf : undefined}
                data-pdf-title={isPdf ? story.title : undefined}
              >
                <span class="story-link-title">{story.title}</span>
                <span class="story-link-meta">{meta}</span>
              </a>
            </li>
          );
        })}
      </ol>
    ) : (
      <p class="coming-soon">Coming soon.</p>
    )}
  </article>
</Base>

<style>
  .writing-page { padding-block: 1rem; }

  .back-row { margin-bottom: 2.5rem; }
  .back-link {
    font-size: 0.75rem;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    color: var(--muted);
    transition: color 0.2s;
  }
  .back-link:hover { color: var(--accent); }

  .page-heading {
    font-family: var(--font-display);
    font-size: clamp(1.8rem, 4.5vw, 2.8rem);
    font-weight: 400;
    color: var(--accent);
    margin-bottom: 2.5rem;
    line-height: 1.1;
    letter-spacing: -0.03em;
  }

  .coming-soon {
    font-size: 1.05rem;
    color: var(--muted);
    font-style: italic;
  }

  /* ── Story list (click → story page, or opens pdf-modal) ── */
  .story-list {
    list-style: none;
    padding: 0;
    margin: 0;
    counter-reset: story;
    border-top: 1px solid var(--border);
  }

  .story-list li {
    counter-increment: story;
    border-bottom: 1px solid var(--border);
  }

  .story-link {
    display: grid;
    grid-template-columns: auto 1fr auto;
    align-items: baseline;
    gap: 1.25rem;
    padding-block: 1.4rem;
    transition: padding-left 0.3s var(--ease);
    position: relative;
  }
  .story-link:hover { padding-left: 1rem; }

  .story-link::before {
    content: counter(story, decimal-leading-zero);
    font-size: 0.72rem;
    color: var(--muted);
    font-variant-numeric: tabular-nums;
    letter-spacing: 0.05em;
  }

  .story-link-title {
    font-family: var(--font-display);
    font-size: clamp(1.1rem, 2.5vw, 1.35rem);
    font-weight: 400;
    color: var(--text);
    transition: color 0.2s;
  }
  .story-link:hover .story-link-title { color: var(--accent); }

  .story-link-meta {
    font-size: 0.78rem;
    color: var(--muted);
    letter-spacing: 0.05em;
    font-style: italic;
    white-space: nowrap;
  }
</style>
