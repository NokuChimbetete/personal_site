---
import Base from '../layouts/Base.astro';

// ✏️ ADD YOUR REAL PROJECTS HERE
const featuredProjects = [
  {
    title: 'Puumba',
    category: 'Hackathon Winner',
    tech: 'TypeScript, LLM integration, Next.js',
    description: 'Duolingo for learning Vibe Coding. My friend and I won the 2025 Minna Hackathon (Tokyo) by creating a platform that gamifies learning to vibe code by pulling a code editor (Trae) into a cartoony UI that guides beginners through useful vibecoding tasks.',
    thumbnail: '/images/project-1.jpg',
    url: '#',
    linkText: 'View Repo',
    demo: 'ka0rcgv2EEM',
  },
  {
    title: 'Minerva Vibe Check',
    category: 'Internal Tool',
    tech: 'JavaScript, Firebase',
    description: 'A real world sorting hat. I helped develop a tool that my university uses to sort incoming first years into "legacy" groups based on a hilarious personality quiz. My primary contribution was the algorithms that sort students, considering the global distribution between the 25 legacies and the answers to the 25 question survey.',
    thumbnail: '/images/project-2.png',
    url: '#',
    linkText: 'View Demo',
    demo: '1qH9jbBBak4',
  },
  {
    title: 'ByteFriend',
    category: 'AI Agent',
    tech: 'Supabase, Node.js',
    description: 'Your first friend in Japan. My friend and I made an AI agent to help tourists and new residents in Japan navigate the immense bureaucratic procedures involved in creating their new lives.',
    thumbnail: '/images/project-3.png',
    url: '#',
    linkText: 'View Demo',
    demo: 'JITQOjOLy4g',
  },
];

// ✏️ TYPEWRITER PHRASES — these cycle on the intro lead line
const typedPhrases = [
  'design great products.',
  'write poetry.',
  'tell silly jokes.',
  'build things.',
  'make art.',
];
---

<Base>
  <!-- ── Intro ── -->
  <section id="intro" class="content-section">
    <p class="intro-lead">
      <span class="intro-lead-static">Hey there friend, I </span><span class="intro-lead-typed" id="typewriter"></span>
    </p>

    <p class="intro-bio">
      Thanks for stopping by. I love talking to strangers :)
      <br />
      (We should have hibiscus tea sometime)
    </p>

    <p class="intro-cta">Open to thoughtful conversations with:</p>
    <ul class="intro-list">
      <li>Designers, engineers and founders interested in building an abundant future for humanity.</li>
      <li>Creatives with cool stories to share.</li>
    </ul>
  </section>

  <!-- ── Projects ── -->
  <section id="projects" class="content-section">
    <h2 class="content-section-title">Projects</h2>

    <div class="projects-stack">
      {featuredProjects.map((p, i) => (
        <article class="project-item reveal" style={`transition-delay: ${i * 0.04}s`}>
          <div class="flip-card">
            <div class="flip-card-inner">
              <!-- Front: thumbnail + tap-to-see-demo hint -->
              <div class="flip-card-front">
                <img src={p.thumbnail} alt={p.title} loading="lazy" />
                <div class="flip-card-front-label">{p.title}</div>
                <span class="flip-card-hint">tap to see demo</span>
              </div>
              <!-- Back: embedded YouTube demo (iframe lazy-injected on first flip) -->
              <div class="flip-card-back">
                {p.demo ? (
                  <>
                    <button type="button" class="flip-card-back-btn" aria-label="Back to thumbnail">← back</button>
                    <div class="flip-card-iframe-slot" data-video-id={p.demo} data-title={`${p.title} demo`}></div>
                  </>
                ) : (
                  <div class="flip-card-back-placeholder">
                    <span class="flip-card-back-placeholder-label">Demo video</span>
                    <span class="flip-card-back-placeholder-sub">Coming soon</span>
                  </div>
                )}
              </div>
            </div>
          </div>

          <!-- Project details (visible below card, no click needed) -->
          <div class="project-details">
            <p class="project-category">{p.category}</p>
            <h3 class="project-title">{p.title}</h3>
            <ul class="project-tags">
              {p.tech.split(', ').map((t) => (
                <li class="project-tag">{t}</li>
              ))}
            </ul>
            <p class="project-desc">{p.description}</p>
            <a href={p.url} target="_blank" rel="noopener" class="project-link">
              {p.linkText || 'View project'} →
            </a>
          </div>
        </article>
      ))}
    </div>
  </section>

  <!-- ── Writing ── -->
  <section id="writing" class="content-section">
    <h2 class="content-section-title">Writing</h2>

    <div class="blog-list">
      <a href="/writing/poetry" class="blog-item">
        <span class="blog-item-title">Poetry</span>
      </a>
      <a href="/writing/short-stories" class="blog-item">
        <span class="blog-item-title">Short Stories</span>
      </a>
      <a href="/writing/essays" class="blog-item">
        <span class="blog-item-title">Essays</span>
      </a>
    </div>
  </section>
</Base>

<script define:vars={{ typedPhrases }}>
  // ── Typewriter effect ──
  const el = document.getElementById('typewriter');
  if (el) {
    let phraseIndex = 0;
    let charIndex = 0;
    let deleting = false;
    const TYPE_SPEED = 80;
    const DELETE_SPEED = 45;
    const PAUSE_AFTER = 1800;
    const PAUSE_BEFORE = 300;

    function tick() {
      const phrase = typedPhrases[phraseIndex];
      if (!deleting) {
        el.textContent = phrase.slice(0, charIndex + 1);
        charIndex++;
        if (charIndex === phrase.length) {
          deleting = true;
          setTimeout(tick, PAUSE_AFTER);
          return;
        }
        setTimeout(tick, TYPE_SPEED);
      } else {
        el.textContent = phrase.slice(0, charIndex - 1);
        charIndex--;
        if (charIndex === 0) {
          deleting = false;
          phraseIndex = (phraseIndex + 1) % typedPhrases.length;
          setTimeout(tick, PAUSE_BEFORE);
          return;
        }
        setTimeout(tick, DELETE_SPEED);
      }
    }
    setTimeout(tick, 900);
  }
</script>
